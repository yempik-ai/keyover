{
  "name": "ai-key-failover",
  "version": "0.1.0",
  "description": "API-key failover for AI provider SDKs through a provider-aware fetch transport.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": ["openai", "anthropic", "claude", "ai-sdk", "api-key", "failover", "fetch", "billing"],
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/openai": "4.0.111",
    "@anthropic-ai/sdk": "1.6.0",
    "@types/node": "26.6.6",
    "ai": "7.0.165",
    "openai": "7.53.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
