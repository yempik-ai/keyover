{
  "name": "keyover",
  "version": "0.1.0",
  "description": "API key failover for OpenAI, Anthropic and the AI SDK. When one billing organization runs out of credit, the request moves to the next key. A drop-in fetch, no gateway, no dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Simone Bova (https://simonebova.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yempik-ai/keyover.git"
  },
  "homepage": "https://yempik-ai.github.io/keyover/",
  "bugs": "https://github.com/yempik-ai/keyover/issues",
  "keywords": [
    "openai",
    "anthropic",
    "claude",
    "ai-sdk",
    "vercel-ai-sdk",
    "llm",
    "api-key",
    "failover",
    "fallback",
    "insufficient_quota",
    "credit-balance",
    "billing",
    "fetch",
    "key-rotation",
    "high-availability"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "bin": {
    "keyover": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "site": "pnpm --filter site dev",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm --filter site typecheck && pnpm --filter site build",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "tables": "node scripts/readme-tables.ts"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/openai": "4.0.111",
    "@anthropic-ai/sdk": "1.6.0",
    "@types/node": "26.6.6",
    "ai": "7.0.165",
    "openai": "7.53.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
